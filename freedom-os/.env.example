# ===== FREEDOM OS 環境変数 =====
# このファイルを .env.local にコピーして値を設定してください。.env.local はコミットしません。

# --- Supabase（必須：本番／Vercel）---
# Supabase ダッシュボード → Project Settings → API
# 勤務先（あんど整骨院）とは別の、個人用 Supabase プロジェクトを作成して使ってください。
NEXT_PUBLIC_SUPABASE_URL=
# 公開してよいキー（anon / publishable）。RLS により本人のデータしか読み書きできません。
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- 新規登録の制限（推奨）---
# カンマ区切りのメールアドレス。設定すると、このアドレス以外はログイン後に利用できません。
# 空の場合は誰でも新規登録できます（データは利用者ごとに分離されます）。
ALLOWED_EMAILS=

# --- AI 経営参謀（任意）---
# 未設定でも全機能が動作し、AI分析はルールベースで表示されます。
# サーバー側だけで使い、ブラウザには一切送りません（NEXT_PUBLIC_ を付けないこと）。
ANTHROPIC_API_KEY=
# 使用モデル（省略時 claude-opus-5-5）
ANTHROPIC_MODEL=claude-opus-5-5

# --- ローカルモード（開発専用）---
# Supabase 未設定のとき、開発環境（npm run dev）ではデータを .data/ フォルダの JSON に保存して動きます。
# 本番ビルド（npm start）で試すときだけ 1 にします。Vercel 上では設定しても無効です。
FREEDOM_ALLOW_LOCAL_MODE=
