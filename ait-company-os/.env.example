# ---- A.I.T company OS 環境変数 ----
# 未設定のままでも DEMO MODE で起動できます。

# CEOログイン用パスコード（未設定ならデモ入場ボタンのみ表示）
CEO_PASSCODE=

# セッション署名用の秘密鍵（32文字以上のランダム文字列。本番では必須）
SESSION_SECRET=

# PHASE 3 で使用：Claude API（サーバー側でのみ読み込み、ブラウザへは出しません）
ANTHROPIC_API_KEY=

# PHASE 3 で使用：Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# デモデータの保存先（省略時は ./.data）
AIT_DATA_DIR=

# 安全制限（省略時は既定値）
AIT_DAILY_BUDGET_JPY=500
AIT_MONTHLY_BUDGET_JPY=10000
AIT_MAX_CONCURRENT_TASKS=3
AIT_MAX_COMMANDS_PER_DAY=30
