# =============================================================================
# A.I.T Follow Manager 環境変数（.env.local にコピーして値を設定）
# すべてサーバー専用（NEXT_PUBLIC_ を付けない＝ブラウザに出さない）
# 本番・開発で Supabase プロジェクトを分け、本番の値は Vercel の Production 環境にのみ設定する
# =============================================================================

# development | staging | production
APP_ENV=development

# アプリの URL（招待・パスワード再設定メールのリンク先、CSRF の Origin 確認に使用）
SITE_URL=http://localhost:3000

# Supabase（ローカルは `npx supabase status -o env` の API_URL / ANON_KEY / SERVICE_ROLE_KEY）
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# RLS をバイパスする強い権限。抽出ジョブと招待処理のみで使用。絶対に公開しないこと
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Cron の認証用（16文字以上のランダム文字列。例：openssl rand -hex 32）
CRON_SECRET=

# 組織管理者・運営管理者に2段階認証（TOTP）を必須にする。本番は必ず true
REQUIRE_ADMIN_MFA=true
