# ---- Enejoy Hand AI部門 OS 環境変数 ----
# 未設定のままでも DEMO MODE で起動できます（ログイン画面に「デモに入る」ボタンが出ます）。

# 統括責任者（岩永）のログイン用パスコード。設定するとデモ入場は無効になります
OPERATOR_PASSCODE=
# 代表（村上）のログイン用パスコード（任意。統括責任者と別の値にしてください）
PRESIDENT_PASSCODE=

# セッション署名用の秘密鍵（32文字以上のランダム文字列。パスコードを使う場合は必須）
SESSION_SECRET=

# 将来使用：Claude API（サーバー側でのみ読み込み、ブラウザへは出しません）
ANTHROPIC_API_KEY=

# 将来使用：Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# データの保存先（省略時は ./.data）
EH_DATA_DIR=

# 安全制限（省略時は既定値）
EH_DAILY_BUDGET_JPY=500
EH_MONTHLY_BUDGET_JPY=10000
EH_MAX_CONCURRENT_TASKS=3
EH_MAX_COMMANDS_PER_DAY=30
