# ---- Enejoy Hand AI部門 OS 環境変数 ----
# 未設定のままでも DEMO MODE で起動できます（ログイン画面に「デモに入る」ボタンが出ます）。

# 統括責任者（岩永）のログイン用パスコード。設定するとデモ入場は無効になります
OPERATOR_PASSCODE=
# 代表（村上）のログイン用パスコード（任意。統括責任者と別の値にしてください）
PRESIDENT_PASSCODE=

# セッション署名用の秘密鍵（32文字以上のランダム文字列。パスコードを使う場合は必須）
SESSION_SECRET=

# 日計表（Googleスプレッドシート）をサービスアカウントで読む場合の鍵ファイル（JSON）のパス
# 未設定なら「リンクを知っている全員」に共有されたシートを公開リンクで読みます（非推奨）
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
# 今月の日計表を自動で読み直す間隔（分）
EH_SHEET_SYNC_MINUTES=5

# Googleビジネスプロフィール（口コミ・表示回数）の接続：Google Cloud の OAuth クライアント（ウェブアプリ）
# 承認済みのリダイレクトURIに http://localhost:3001/api/google/callback を登録してください
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# 別のURLで動かす場合のみ（例：https://ai.example.com）
GOOGLE_OAUTH_REDIRECT_BASE=
# 口コミ・表示回数を自動で読み取る間隔（時間）
EH_GOOGLE_SYNC_HOURS=6

# 地域の競合（Places API (New)）のAPIキー。アプリのサーバー側だけで使い、ブラウザには出しません
GOOGLE_MAPS_API_KEY=

# 将来使用：Claude API（サーバー側でのみ読み込み、ブラウザへは出しません）
ANTHROPIC_API_KEY=

# 将来使用：Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# データの保存先（省略時は ./.data）
EH_DATA_DIR=

# 安全制限（省略時は既定値）
EH_DAILY_BUDGET_JPY=500
EH_MONTHLY_BUDGET_JPY=10000
EH_MAX_CONCURRENT_TASKS=3
EH_MAX_COMMANDS_PER_DAY=30
