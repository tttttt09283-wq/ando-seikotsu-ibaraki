# Supabase（既存プロジェクト）。値は Vercel の環境変数に設定し、リポジトリには入れない
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバー専用（ID・PASSの発行・退職者の停止・定期処理だけに使う）。ブラウザに出さない
SUPABASE_SERVICE_ROLE_KEY=
# ログインIDに付けるドメイン（POSと同じ）。tanaka → tanaka@ando.jp
LOGIN_ID_DOMAIN=ando.jp
# 定期処理（/api/cron/daily）の合言葉。Vercel の Cron は自動で「Authorization: Bearer <CRON_SECRET>」を付けて呼ぶ
CRON_SECRET=
