# ---- A.I.T Cash Flow 環境変数 ----
# このファイルをコピーして .env.local を作り、値を入れてください（.env.local はコミットしない）。
# Supabase を設定しない場合は「デモモード」（架空のデモデータ・ログインなし）で起動します。

# Supabase の Project URL（Project Settings → API）
NEXT_PUBLIC_SUPABASE_URL=
# Supabase の公開キー（publishable key。旧称 anon key）。ブラウザに出ても安全なキーです
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# サービスロールキー（secret key）はこのアプリでは使いません。設定しないでください。

# 本番ビルド（next start）を Supabase なしのデモとして動かす場合だけ 1（通常は空のまま）
CASHFLOW_ALLOW_DEMO=

# フェーズ4（AI分析）で使う予定。サーバー側でのみ読み込み、ブラウザには出しません
# ANTHROPIC_API_KEY=
