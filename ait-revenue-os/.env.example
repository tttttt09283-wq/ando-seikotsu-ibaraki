# ===== A.I.T Revenue OS 設定 =====
# このファイルを「.env」という名前でコピーして使います（.env は Git に保存されません）。
# 何も設定しなくても、テンプレート生成モードで全画面が動きます。

# Anthropic APIキー（未設定ならテンプレート生成モード）
ANTHROPIC_API_KEY=

# 使用するClaudeモデル（既定：claude-opus-5-5）
AIT_MODEL=claude-opus-5-5

# AI利用料の1日の上限（円）。超えるとAI生成を止めてテンプレートに切り替えます
AIT_AI_DAILY_BUDGET_YEN=300

# 費用計算に使う為替レート（1ドル＝何円）
AIT_USD_JPY=150

# データベースの保存先（既定：data/ait_revenue.db）
AIT_DB_PATH=

# ===== Threads（Meta 公式API）=====
# 未設定なら Threads は「手動記録モード」（投稿の数字を手入力して分析）で動きます。
THREADS_ACCESS_TOKEN=
# トークンを発行した日時（自動更新で書き換わります。例：2026-10-17T19:00:00）
THREADS_TOKEN_ISSUED_AT=
# APIの接続先（Metaの公式ドキュメントで変更があった場合のみ書き換え）
THREADS_API_BASE=https://graph.threads.net/v1.0

# 予約投稿のスイッチ（true にするまで実際の投稿は一切行いません）
AIT_THREADS_POSTING_ENABLED=false
# 1日の投稿上限（公式の上限250件より大幅に少なく。スパム防止）
AIT_THREADS_DAILY_LIMIT=5
# 投稿と投稿の最短間隔（分）
AIT_THREADS_MIN_INTERVAL_MIN=60
# コンテナ作成から公開までの待ち時間（秒。公式推奨 約30秒）
AIT_THREADS_PUBLISH_WAIT_SEC=30

# ===== Instagram（数字の読み取りのみ）=====
# アプリの「連携設定」画面から貼り付けると自動で保存されます
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_TOKEN_ISSUED_AT=
INSTAGRAM_API_BASE=https://graph.instagram.com

# ===== Google（Search Console・ビジネスプロフィール）=====
# ログイン情報は .env ではなく .secrets/ フォルダに保存されます（「連携設定」画面からログイン）
