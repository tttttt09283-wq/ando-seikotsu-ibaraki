# 本部システム（hq/）の Vercel の環境変数。値は Vercel の画面で設定し、このファイルやコードに本物の値を書かないこと。
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# 任意（未設定なら既定のシート・フォルダ）
SALES_SHEET_ID=
CAREER_SHEET_ID=
NEWPATIENT_SHEET_ID=
PATIENT_CARE_SHEET_ID=
ORG_SHEET_ID=
BUDGET_SHEET_ID=
DAILY_FOLDER_ID=
WAGE_SHEET_ID=
KPI_SHEET_ID=
SHIFT_FOLDER_ID=
SHIFT_SHEET_ID=
# EHMS はブラウザから Supabase（公開キー）で動き、行単位の権限（RLS）で守る。追加の環境変数は不要。
