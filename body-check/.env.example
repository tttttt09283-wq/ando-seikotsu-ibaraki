# ===== あんど式 カラダ年齢チェック 環境変数のサンプル =====
# このファイルをコピーして「.env.local」という名前で保存し、値を設定してください。
# （Vercel では「Settings → Environment Variables」で同じ名前を登録します）

# WEB予約ページのURL（https:// から始まるURL）
# 未設定のままだと、結果画面の予約ボタンは「準備中」として無効化されます。
NEXT_PUBLIC_BOOKING_URL=

# 匿名の利用統計を送信するか（true / false）
# true にすると、チェック前に利用目的の説明と同意の確認が表示されます。
# 同意した人の分だけ、個人を特定しない統計データが /api/stats に送られます。
NEXT_PUBLIC_STATS_ENABLED=false

# ===== 販売ページ（/for-clinics）用 =====
# このアプリの公開URL（デモのQRコード・テンプレートの初期値に使います）
NEXT_PUBLIC_SITE_URL=https://ando-body-check.vercel.app
# 導入のお問い合わせ先（LINE公式アカウントのURLや申込フォームのURL）。未設定なら「準備中」と表示
NEXT_PUBLIC_SALES_CONTACT_URL=
# 導入のお問い合わせ用メールアドレス（任意）
NEXT_PUBLIC_SALES_CONTACT_EMAIL=
