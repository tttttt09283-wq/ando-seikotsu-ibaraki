# =====================================================================
# 岩永拓己 鍼灸 予約管理 — 環境変数の例（.env.local にコピーして使う）
#   NEXT_PUBLIC_ で始まる値だけがブラウザに公開されます。それ以外は絶対に公開しないこと。
#   すべて未設定でも「ローカル代替モード」で動きます（本番では起動を拒否します）。
# =====================================================================

# --- サイト ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- データベース（Supabase の PostgreSQL）---
# Supabase ダッシュボード → Connect → Transaction pooler（ポート 6543）の接続文字列
DATABASE_URL=
# 任意：Supabase の SSL 証明書（PEM。改行は \n）。設定すると証明書を検証して接続します
DATABASE_CA_CERT=
DATABASE_POOL_MAX=3

# --- 管理者ログイン（Supabase Auth）---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- 個人情報の暗号化（必須・本番）---
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HASH_PEPPER=

# --- LINE 公式アカウント（岩永個人の公式LINE・Messaging API）---
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Webhook の destination（ボットのユーザーID。U から始まる）。送信元照合に使用
LINE_BOT_USER_ID=
# 公式LINEのベーシックID（@から始まる）。トーク画面への遷移に使用（公開情報）
NEXT_PUBLIC_LINE_BASIC_ID=
# 任意：LIFF / LINE Login による本人識別
NEXT_PUBLIC_LIFF_ID=
LINE_LOGIN_CHANNEL_ID=

# --- 管理者への通知 ---
# LINE で管理者に通知する場合（メッセージ通数を消費します）
ADMIN_LINE_NOTIFY=false
ADMIN_LINE_USER_IDS=
# メール通知（Resend）
RESEND_API_KEY=
MAIL_FROM=
ADMIN_NOTIFY_EMAILS=

# --- Vercel Cron の認証（Vercel が Authorization: Bearer で送ります）---
CRON_SECRET=

# --- 予約の仮押さえ・保持期間 ---
LINE_HOLD_MINUTES=30
REVIEW_HOLD_HOURS=48
PROPOSAL_HOLD_HOURS=48
CONSULTATION_RETENTION_DAYS=90
CUSTOMER_RETENTION_DAYS=1095

# --- ローカル代替モードだけで使う ---
ADMIN_LOCAL_PASSWORD=change-me-local-only
SESSION_SECRET=
# デモ用に本番ビルドでローカル代替モードを許可する（通常は設定しない）
ALLOW_LOCAL_MODE_IN_PRODUCTION=
