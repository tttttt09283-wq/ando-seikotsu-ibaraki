{
  "crons": [
    {
      "path": "/api/send-reminders",
      "schedule": "0 9 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/mandala",
      "destination": "/api/evaluation?__mandala=1"
    },
    {
      "source": "/beauty",
      "destination": "/beauty.html"
    },
    {
      "source": "/beauty-menu",
      "destination": "/beauty-menu.html"
    },
    {
      "source": "/taikan",
      "destination": "/core-test.html"
    },
    {
      "source": "/taikan/:clinic",
      "destination": "/core-test.html"
    },
    {
      "source": "/incentive",
      "destination": "/incentive.html"
    },
    {
      "source": "/nail-goods",
      "destination": "/nail-goods.html"
    },
    {
      "source": "/mandala",
      "destination": "/mandala.html"
    }
  ]
}
